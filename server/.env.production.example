# Generate .env.production using scripts/init_production.py. Never commit secrets.
DEPLOYMENT_ENV=production
ALLOW_HTTP_IP_DEPLOYMENT=false
API_BIND_ADDRESS=127.0.0.1
debug=false
url_prefix=/api
POSTGRES_PASSWORD=change-me-generated-by-script
secret_key=change-me-generated-by-script
CHAT_SHARE_SECRET_KEY=change-me-generated-by-script
CHAT_SHARE_SALT=change-me-generated-by-script
TOKEN_ISSUER=https://api.example.com
TOKEN_AUDIENCE=eigent-api
CORS_ALLOW_ORIGINS=https://app.example.com
REMOTE_CONTROL_WEB_ORIGIN=https://app.example.com
REMOTE_CONTROL_ALLOW_UNSAFE_ORIGINS=false
ALLOW_LOCAL_AUTO_LOGIN=false
ALLOW_REGISTRATION=false
REGISTRATION_REQUIRE_APPROVAL=true
PRIVATE_UPLOADS=true
ENABLE_TRIGGER_SCHEDULE_POLLER_TASK=true
ENABLE_EXECUTION_TIMEOUT_CHECKER=true
REMOTE_CONTROL_TRUSTED_PROXY_HOSTS=172.30.21.10
FORWARDED_ALLOW_IPS=172.30.21.10
